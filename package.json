{
  "name": "always-on-agent-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Always-on agent MVP on AWS (Event inbox + Worker + AgentCore Runtime + S3 memory + send tool)",
  "license": "MIT-0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:agent": "node scripts/build-agent.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "agent:local": "STORE=local tsx src/agent/main.ts",
    "aoa": "node scripts/aoa.mjs",
    "scenario:local": "node scripts/local-scenario.mjs"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1169.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1169.0",
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/client-sns": "^3.1169.0",
    "@aws-sdk/client-sqs": "^3.1169.0",
    "@aws-sdk/credential-provider-node": "^3.972.97",
    "@aws-sdk/lib-dynamodb": "^3.1169.0",
    "@smithy/node-http-handler": "^4.14.2",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.5",
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "aws-cdk": "^2.1148.1",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
